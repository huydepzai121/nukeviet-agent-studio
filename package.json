{
  "name": "nukeviet-agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop AI coding harness for NukeViet CMS — ACP client, workflow canvas, NukeViet 4.x and 5.x knowledge.",
  "author": "NukeViet Agent Studio",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/bundle-agent.mjs && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "node scripts/bundle-agent.mjs && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node scripts/bundle-agent.mjs && vitest run",
    "icons": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
